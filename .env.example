# Supabase. Vercel-integrasjonen setter disse automatisk i produksjon.
# Godtar også NEXT_PUBLIC_SUPABASE_ANON_KEY som alternativ til PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://ditt-prosjekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Overstyrer domenet metadata og hreflang bygges fra.
# NEXT_PUBLIC_SITE_URL=https://chenmedia.no

# Sett til "ton" for å se TON-nær tekstvariant. Se docs/tekstvarianter.md.
# NEXT_PUBLIC_COPY_VARIANT=ton

# HubSpot. Kontaktskjemaet videresendes hit fra serveren.
#
# Ingen av disse er hemmeligheter — portal-ID og skjema-GUID er offentlige
# verdier, og innsendingsendepunktet krever ingen API-nøkkel. De står likevel
# uten NEXT_PUBLIC_, siden de ikke har noe i klientbundelen å gjøre.
#
# Uten dem lagres henvendelser fortsatt, men står som ventende i
# /admin/henvendelser til de kan sendes videre med knappen der.
#
# Merk: skjemaet i HubSpot må ha BÅDE reCAPTCHA og legal consent slått av.
# API-innsending virker ikke med noen av delene.
HUBSPOT_PORTAL_ID=3060835
HUBSPOT_FORM_GUID=23bfc26f-6bc1-4fe1-a256-92dd5e6ead80

# ID-en til abonnementstypen samtykket til markedsføring gjelder.
# HubSpot → Settings → Marketing → Email → Subscription Types; ID-en står i
# URL-en når du åpner typen.
#
# Uten denne sendes samtykket ikke til HubSpot i det hele tatt. Et samtykke
# uten abonnementstype har ingen steder å havne, og da er det bedre å la
# være enn å sende noe som ser riktig ut. Skjemaet i HubSpot må også ha
# consent slått PÅ når denne er satt, ellers avvises innsendingen — koden
# prøver da på nytt uten samtykket og noterer det på raden i admin.
# HUBSPOT_SUBSCRIPTION_TYPE_ID=

# Varsel i Slack når en henvendelse kommer inn.
#
# Dette lå opprinnelig hos HubSpot, men da måtte både videresendingen og
# HubSpots egen varsling virke for at Kai skulle få vite om en ny kunde. To
# innsendinger nådde HubSpot uten at det kom varsel. Nå sendes det rett etter
# at henvendelsen er lagret, uavhengig av HubSpot.
#
# Lages i Slack: api.slack.com/apps → Create New App → From scratch → velg
# arbeidsområdet → Incoming Webhooks → slå på → Add New Webhook to Workspace
# → velg kanal. Kopier URL-en som begynner med https://hooks.slack.com/.
#
# Dette ER en hemmelighet: hvem som helst med URL-en kan poste i kanalen.
# Sett den som Sensitive i Vercel.
#
# Mangler den, lagres henvendelsen som normalt og merkes «Ikke varslet» i
# /admin/henvendelser.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Salt for hashing av IP-adresser i rate limit på kontaktskjemaet.
# IP-en lagres aldri rå, og hashen nulles etter 30 dager. Uten dette settet er
# hashen bare obfuskering: IPv4-rommet er lite nok til at en usaltet SHA-256
# kan reverseres med en full tabell. Sett en lang tilfeldig streng.
# ENQUIRY_IP_PEPPER=
